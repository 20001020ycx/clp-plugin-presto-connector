@@ -0,0 +1,38 @@
+#ifndef CLP_THESISNETWORKCOUNTERS_HPP
+#define CLP_THESISNETWORKCOUNTERS_HPP
+
+#include <cstdint>
+
+namespace clp {
+/**
+ * thesis-metrics: counters of what `NetworkReader` instances did on behalf of the calling thread.
+ * Measurement only; nothing reads them to make a decision. A caller takes the difference of two
+ * readings made on the same thread.
+ */
+struct ThesisNetworkCounters {
+    // Time the reading thread was blocked in `get_filled_buffer` because no downloaded data was
+    // buffered yet, and the number of such waits.
+    uint64_t wait_ns{0};
+    uint64_t wait_count{0};
+    // Bytes the reading thread took out of the buffers (read or skipped by a forward seek).
+    uint64_t bytes_consumed{0};
+    // `NetworkReader` instances constructed by this thread (each sends one HTTP GET).
+    uint64_t requests{0};
+    // The following are added when a `NetworkReader` is destroyed, on the destroying thread.
+    uint64_t readers_closed{0};
+    // Bytes libcurl handed to the write callback.
+    uint64_t bytes_downloaded{0};
+    // Time the destructor spent asking the download to stop and waiting for the downloader thread.
+    uint64_t close_wait_ns{0};
+    // CPU and wall time of the downloader thread's `thread_method`.
+    uint64_t downloader_cpu_ns{0};
+    uint64_t downloader_wall_ns{0};
+};
+
+/**
+ * @return The calling thread's counters.
+ */
+[[nodiscard]] auto thesis_network_counters() -> ThesisNetworkCounters&;
+}  // namespace clp
+
+#endif  // CLP_THESISNETWORKCOUNTERS_HPP
